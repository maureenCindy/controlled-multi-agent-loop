---
import BaseLayout from "../layouts/BaseLayout.astro";
import { WHATSAPP_NOTIFICATIONS_ENABLED } from "../lib/featureFlags";
---
<BaseLayout
  title="Never miss a PRAZ tender again"
  description="TenderBell watches Zimbabwe's PRAZ e-GP portal for you and alerts you the moment a tender matches your business."
>
  <section class="hero">
    <div class="container">
      <img
        src="/tenderbell-website-logo.svg"
        alt="TenderBell"
        class="hero-logo"
        width="220"
        height="116"
      />
      <p class="hero-tagline">Alerts Insights and Opportunities</p>
      <span class="eyebrow">Built for Zimbabwe</span>
      <h1>Never miss a government tender in Zimbabwe again.</h1>
      <p class="lede">
        TenderBell watches PRAZ's e-Government Procurement portal (egp.praz.org.zw) around the
        clock and tells you the moment a tender matches what your business actually does —
        no more refreshing a government website by hand.
      </p>
      <div class="hero-cta-row">
        <a class="btn btn-accent" href="/signup">Get free alerts</a>
        <a class="btn btn-outline" href="/how-it-works">See how it works</a>
      </div>

      <div class="hero-icons">
        <div class="hero-icon">
          <span class="hero-icon-badge hero-icon-badge--primary">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="10" cy="10" r="6" />
              <line x1="15" y1="15" x2="20" y2="20" />
            </svg>
          </span>
          <span>Find</span>
        </div>
        <div class="hero-icon">
          <span class="hero-icon-badge hero-icon-badge--success">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" y1="20" x2="4" y2="14" />
              <line x1="12" y1="20" x2="12" y2="9" />
              <line x1="20" y1="20" x2="20" y2="4" />
            </svg>
          </span>
          <span>Gain</span>
        </div>
        <div class="hero-icon">
          <span class="hero-icon-badge hero-icon-badge--accent">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 17c0-5 1.5-9 6-9s6 4 6 9" />
              <path d="M4 17h16" />
              <path d="M10 20a2 2 0 0 0 4 0" />
            </svg>
          </span>
          <span>Never Miss</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <div class="grid grid-3">
        <div class="card">
          <span class="eyebrow">The problem</span>
          <h3>Tenders are easy to miss</h3>
          <p>
            PRAZ publishes new tenders continuously across every sector and region in Zimbabwe.
            Checking manually means you either watch constantly or find out too late.
          </p>
        </div>
        <div class="card">
          <span class="eyebrow">The solution</span>
          <h3>We watch PRAZ for you</h3>
          <p>
            TenderBell fetches PRAZ e-GP tenders on a shared schedule and matches them against
            the sectors, value range, region and keywords you tell us matter to your business.
          </p>
        </div>
        <div class="card">
          <span class="eyebrow">The result</span>
          <h3>You get notified, not buried</h3>
          <p>
            Free plans get a daily digest of matches. Paid plans get notified as soon as a match
            is found in each aggregation run — either way, always a link back to the official
            PRAZ listing, never a copy.
            {WHATSAPP_NOTIFICATIONS_ENABLED && (
              <>
                {" "}Paid subscribers can also opt in to receive those notifications via
                WhatsApp.
              </>
            )}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="text-align:center;">
      <h2>Set up your first alert in a couple of minutes</h2>
      <p class="lede" style="margin-left:auto;margin-right:auto;">
        Tell us your email, choose a plan, and start getting matched PRAZ tenders for Zimbabwe —
        free to start, no commitment required.
      </p>
      <a class="btn btn-primary" href="/signup">Get started free</a>
    </div>
  </section>
</BaseLayout>
