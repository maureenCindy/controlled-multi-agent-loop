# TP-042/TP-127: PayPal subscription verification (POST /api/v1/subscribers/pro, and the unified
# POST /api/v1/billing/paypal/subscriptions/confirm added by TP-127/issue #127).
#
# Copy this file to `.env` (or otherwise export these as real environment variables) and fill in
# your own PayPal Developer sandbox app's credentials for local development. `.env` itself is
# git-ignored — never commit real values.
#
# Get sandbox credentials: https://developer.paypal.com/dashboard/applications/sandbox
# Create two recurring Plans (Pro and Max) under one Product via the PayPal dashboard or the
# `POST /v1/billing/plans` API, then put their IDs in PAYPAL_PRO_PLAN_ID / PAYPAL_MAX_PLAN_ID below.
#
# Non-dev/test deployments: com.tenderpulse.paypal.PayPalPlanConfigGuard refuses to start if either
# plan id is blank (fail closed) — see application.yml.

# Sandbox vs. live PayPal REST API base URL. Use the live URL only in production.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# From your PayPal Developer app (Sandbox or Live, matching PAYPAL_BASE_URL). PAYPAL_CLIENT_ID is
# also returned (public, non-secret) by GET /api/v1/billing/public-config for the checkout SDK;
# PAYPAL_CLIENT_SECRET must never reach the browser or be logged.
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# TP-127 (issue #127): replaces the old single PAYPAL_PLAN_ID -- Pro and Max each have their own
# PayPal Plan ID, matched against POST /api/v1/billing/paypal/subscriptions/confirm's
# `requestedPlan`. POST /api/v1/subscribers/pro (TP-042) also reads PAYPAL_PRO_PLAN_ID unchanged.
PAYPAL_PRO_PLAN_ID=your-paypal-pro-plan-id
PAYPAL_MAX_PLAN_ID=your-paypal-max-plan-id

# TP-044: shared secret required on every /api/v1/admin/** request as the X-Admin-Key header
# (single-operator admin API — subscriber list/tier overrides, PayPal plan pricing updates).
# Generate a long random value yourself (e.g. `openssl rand -hex 32`); never commit the real
# value. If unset, the admin API fails closed (every admin request is rejected) rather than
# falling back to any default.
TENDERPULSE_ADMIN_KEY=your-long-random-admin-key

# Existing Postgres datasource vars (TP-048) — see README.md for defaults.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tenderpulse
# DB_USER=tenderpulse
# DB_PASSWORD=tenderpulse

# TP-034: marketing site CORS. Comma-separated list of origins allowed to call
# POST /api/v1/subscribers and POST /api/v1/subscribers/pro (only). Empty by default — no
# cross-origin signup works until this is set. For local dev against `npm run dev` in
# apps/website (Astro's default port):
# WEBSITE_ALLOWED_ORIGINS=http://localhost:4321
