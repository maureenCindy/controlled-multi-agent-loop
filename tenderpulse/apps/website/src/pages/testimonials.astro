---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Testimonials"
  description="TenderPulse is in early access — real customer stories will appear here as they come in."
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Testimonials</span>
      <h1>We're in early access</h1>
      <p class="lede">
        TenderPulse is brand new. We don't have customer stories to share yet, and we're not
        going to invent any — this section is a placeholder that will fill in with real quotes
        from real subscribers as they come in.
      </p>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <div class="placeholder-card">
        <h3>Testimonials coming soon</h3>
        <p>
          If you're one of our first subscribers and TenderPulse has helped you catch a tender
          you'd have otherwise missed, we'd love to hear about it — this space is reserved for
          your story.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="text-align:center;">
      <h2>Be one of our first Zimbabwean subscribers</h2>
      <a class="btn btn-accent" href="/signup">Get started free</a>
    </div>
  </section>
</BaseLayout>
