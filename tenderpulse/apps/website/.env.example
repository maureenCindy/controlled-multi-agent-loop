# TP-034: marketing site build-time env vars. Astro only exposes vars prefixed PUBLIC_ to
# client-side/browser code — see https://docs.astro.build/en/guides/environment-variables/.
#
# Copy this file to `.env` for local `npm run dev` (git-ignored, never commit real values).
# For a real deployment, set these as build-time env vars in whatever hosts the static build
# (out of scope for this issue — see the issue's "Scope out").

# Base URL of the running TenderPulse API (no trailing slash). The signup form POSTs directly
# to "$PUBLIC_API_BASE_URL/api/v1/subscribers" (Free) and
# "$PUBLIC_API_BASE_URL/api/v1/subscribers/pro" (Pro). Must be an origin the API's CORS config
# (WEBSITE_ALLOWED_ORIGINS in apps/api) explicitly allows.
PUBLIC_API_BASE_URL=http://localhost:8080

# --- PayPal Pro-tier subscription button -----------------------------------------------------
#
# PLACEHOLDER VALUES — Pro signup will NOT work until these are replaced with real PayPal
# Developer Dashboard credentials (sandbox for testing, live for production):
#   1. Create/log into a PayPal Developer app: https://developer.paypal.com/dashboard/applications
#   2. Copy its Client ID into PUBLIC_PAYPAL_CLIENT_ID below.
#   3. Create a recurring Billing Plan (POST /v1/billing/plans, or via the dashboard) and copy
#      its Plan ID into PUBLIC_PAYPAL_PLAN_ID below. This must be the SAME plan ID configured as
#      PAYPAL_PLAN_ID on the backend (apps/api/.env.example) so verification succeeds.
#
# Both are safe to expose to the browser (PUBLIC_ prefix) — they identify the PayPal app/plan,
# they are not secrets. The Client Secret used to verify subscriptions stays server-side only
# (apps/api's PAYPAL_CLIENT_SECRET), never here.
PUBLIC_PAYPAL_CLIENT_ID=REPLACE_WITH_REAL_PAYPAL_CLIENT_ID
PUBLIC_PAYPAL_PLAN_ID=REPLACE_WITH_REAL_PAYPAL_PLAN_ID
